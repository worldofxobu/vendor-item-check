local db: any = rawget(_G, "VendorItemCheckDB")
local personalReplay: any = rawget(_G, "VendorItemCheckLocalReplay")
local fixture = db and db.observations and db.observations.reporterId == "vic-00000000000000000000000000000001"
if personalReplay or fixture then
    -- WoWLua's virtual date predates these observations. Replay them as of the capture.
    local asOf = personalReplay and personalReplay.asOf or 1795018798
    _G["GetServerTime"] = function() return asOf end

    local frame = CreateFrame("Frame")
    frame:RegisterEvent("PLAYER_LOGIN")
    frame:SetScript("OnEvent", function()
        frame:UnregisterEvent("PLAYER_LOGIN")
        C_Timer.After(0.5, function()
            local vic: any = _G["VendorItemCheck"]
            vic:OpenBrowser()
            if personalReplay then return end
            local panel = vic.browserPanel
            panel.vendorsTab:Click()
            panel.search:SetText("Edna Mullby")
            panel.search:ClearFocus()
            vic:RefreshBrowser()
            if panel.rows[1] and panel.rows[1].id == 1286 then
                panel.list[1]:Click()
            end
        end)
    end)
end
