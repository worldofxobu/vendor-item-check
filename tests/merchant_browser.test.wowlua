import test from "wowlua:test"
import * as mock from "wowlua:mock"

local items = {
    { id = 900101, name = "Fixture Zebra Seed", price = 400, stack = 1, available = -1 },
    { id = 900102, name = "Fixture Arcane Infusion", price = 105, stack = 2, available = 3 },
    { id = 900103, name = "Fixture Bitter Root", price = 85, stack = 1, available = 0 },
    { id = 900104, name = "Fixture Copper Vial", price = 120, stack = 1, available = 4 },
    { id = 900105, name = "Fixture Dark Dye", price = 125, stack = 1, available = -1 },
    { id = 900106, name = "Fixture Ember Powder", price = 130, stack = 1, available = -1 },
    { id = 900107, name = "Fixture Fine Thread", price = 135, stack = 1, available = -1 },
    { id = 900108, name = "Fixture Glass Flask", price = 140, stack = 1, available = -1 },
    { id = 900109, name = "Fixture Heavy Salt", price = 145, stack = 1, available = -1 },
    { id = 900110, name = "Fixture Indigo Pigment", price = 150, stack = 1, available = -1 },
    { id = 900111, name = "Fixture Journeybread with Very Long Enchanted Ingredients", price = 200050, stack = 50, available = 250 },
}

local farID = 900001
local nearID = 900002
local trackedItem = 900102
local farName = "Bronze Reagent Merchant of the Eastern Trade Consortium"
local nearName = "Zephyr Supply Merchant"

local function addon(): any
    local vic: any = _G["VendorItemCheck"]
    assert(vic and vic.client == "forever" and vic.settings.recordMerchants, "Forever merchant recording did not initialize")
    return vic
end

local function farMerchant()
    local slots: any = {}
    for i, item in ipairs(items) do
        mock.defineItem(item.id, { name = item.name, icon = 134712, maxStack = 200, quality = 1 })
        slots[i] = { id = item.id, price = item.price, stack = item.stack, available = item.available }
    end
    mock.moveTo({ mapID = 1429, zone = "Elwynn Forest", x = 0.22, y = 0.35 })
    local npc = mock.spawnUnit({
        name = farName, guid = "Creature-0-1-2-3-900001-0000000001", reaction = "friendly", distance = 2,
    })
    mock.defineVendor(npc, { items = slots })
    mock.player:interact(npc)
    mock.waitUntil(function() return GetMerchantNumItems() == #items end, "merchant inventory")
    mock.waitUntil(function() return addon():GetItemVendors(trackedItem) ~= nil end, "recorded merchant offers")
end

local function nearMerchant()
    mock.closeMerchant()
    mock.moveTo({ mapID = 1429, zone = "Elwynn Forest", x = 0.61, y = 0.52 })
    local npc = mock.spawnUnit({
        name = nearName, guid = "Creature-0-1-2-3-900002-0000000002", reaction = "friendly", distance = 2,
    })
    mock.defineVendor(npc, { items = { { id = trackedItem, price = 200, stack = 2, available = -1 } } })
    mock.player:interact(npc)
    mock.waitUntil(function() return addon():GetItemVendors(trackedItem).totalCount == 2 end, "second merchant")
    mock.closeMerchant()
    mock.waitSeconds(0.25)
end

local function browser(): any
    mock.slash("/vic")
    local panel = addon().browserPanel
    assert(panel and panel:IsVisible(), "/vic did not open the browser")
    return panel
end

local function freshBrowser(): any
    local vic = addon()
    local panel = vic.browserPanel
    if panel then
        panel:Hide()
        panel.tab, panel.filters, panel.tabStates, panel.history = "items", {}, {}, {}
        panel.selected, panel.expanded, panel.index = nil, nil, nil
        panel.search:SetText("")
        panel.detailSearch:SetText("")
    end
    return browser()
end

local function choose(button: any, label: string)
    mock.click(button)
    local menu = addon().browserPanel.menu
    assert(menu:IsVisible(), "the menu did not open")
    for _, row in ipairs(menu.rows) do
        if row:IsVisible() and row.entryLabel:GetText():find(label, 1, true) then
            mock.click(row)
            assert(not menu:IsShown(), "the menu did not close")
            return
        end
    end
    error("Missing menu choice: " .. label)
end

local function selectVendor(panel: any)
    if panel.tab ~= "vendors" then mock.click(panel.vendorsTab) end
    if panel.compact and panel.selected then mock.click(panel.back) end
    if panel.clearSearch:IsVisible() then mock.click(panel.clearSearch) end
    mock.typeText(panel.search, "Bronze")
    assert(#panel.rows == 1 and panel.rows[1].id == farID, "vendor name search")
    mock.click(panel.list[1])
    assert(panel.selected == farID and panel.heading:GetText() == farName, "vendor selection")
end

local function selectItem(panel: any)
    if panel.tab ~= "items" then mock.click(panel.itemsTab) end
    if panel.compact and panel.selected then mock.click(panel.back) end
    mock.waitUntil(function() return addon():BrowserItemName(trackedItem) == items[2].name end, "resolved item name")
    if panel.clearSearch:IsVisible() then mock.click(panel.clearSearch) end
    mock.typeText(panel.search, tostring(trackedItem))
    assert(#panel.rows == 1 and panel.rows[1].id == trackedItem, "item ID search")
    mock.click(panel.list[1])
    assert(panel.selected == trackedItem and panel.heading:GetText() == "Fixture Arcane Infusion", "item selection")
end

local function hasLine(lines: string[], fragment: string): boolean
    for _, line in ipairs(lines) do
        if line:find(fragment, 1, true) then return true end
    end
    return false
end

local function separated(first: any, second: any, reason: string)
    assert(first:GetRight() <= second:GetLeft() + 0.1 or second:GetRight() <= first:GetLeft() + 0.1 or
        first:GetTop() <= second:GetBottom() + 0.1 or second:GetTop() <= first:GetBottom() + 0.1, reason)
end

local function frontOf(label: any, surface: any)
    local parent = label:GetParent()
    assert(label:IsVisible() and (parent == surface or parent:GetFrameLevel() > surface:GetFrameLevel()),
        "a browser surface covers: " .. label:GetText())
end

local function fits(label: any)
    assert(label:GetUnboundedStringWidth() <= label:GetWidth() + 0.1, "clipped text: " .. label:GetText())
end

@test("renders the native merchant window and records its inventory")
local function merchantWindow()
    farMerchant()
    local frame: any = _G["MerchantFrame"]
    assert(frame and frame:IsVisible(), "the native merchant window did not open")
    local vic = addon()
    local offer = vic:GetItemVendors(trackedItem).vendors[1]
    assert(vic:GetItemVendors(items[3].id).vendors[1].stock == 0, "sold-out offers were not recorded")
    assert(offer.id == farID and offer.name == farName, "merchant identity")
    assert(offer.stock == 3 and offer.quantity == 2 and offer.copper == 105, "observed stock and batch cost")
end

@test("renders the vendor inventory and supports filters, paging and selection")
local function inventory()
    mock.closeMerchant()
    local panel = browser()
    -- Open the browser before visiting so the merchant events must update an open panel.
    farMerchant()
    mock.closeMerchant()
    mock.waitSeconds(0.3)
    selectVendor(panel)
    assert(panel.detailCount:GetText() == "Page 1 of 2", "eight items per page")
    assert(panel.details[1].row.id == trackedItem, "inventory must be sorted by name")
    assert(panel.details[2].row.id == items[3].id, "the second item is alphabetical")
    frontOf(panel.heading, panel.detailHeader)
    frontOf(panel.description, panel.detailHeader)
    frontOf(panel.detailCount, panel.detailsInset)
    local screenWidth = GetPhysicalScreenSize()
    if screenWidth == 480 then assert(panel.compact, "the narrow viewport must use the compact layout") end
    assert(panel:GetFrameStrata() == "DIALOG", "the default HUD should be below the browser")
    if panel.compact then
        assert(not panel.list[1]:IsVisible() and panel.back:IsEnabled(), "compact selection should show details with Back")
    else
        frontOf(panel.count, panel.resultsInset)
        assert(panel.count:GetText() == "1 vendor", "the count should agree with the filtered results")
    end
    separated(panel.heading, panel.track, "vendor heading overlaps the waypoint button")
    separated(panel.description, panel.track, "vendor description overlaps the waypoint button")
    separated(panel.details[1], panel.details[2], "inventory cards overlap")
    separated(panel.detailSearch, panel.stock, "inventory search overlaps stock filter")
    assert(panel.details[1].offer:GetText():find(" / 2", 1, true), "batch price is missing")
    assert(panel.details[1].stock:GetText() == "3 left" and panel.details[1].row.vendor.quantity == 2, "stock and stack size are missing")
    separated(panel.details[1].caption, panel.details[1].offer, "inventory caption overlaps price")
    separated(panel.details[1].stock, panel.details[1].offer, "inventory stock overlaps price")
    fits(panel.details[1].offer)
    fits(panel.details[1].stock)
    mock.click(panel.next)
    local last = panel.details[panel.waypointBanner:IsShown() and 5 or 3]
    assert(panel.detailCount:GetText() == "Page 2 of 2" and last.row.id == items[1].id, "last inventory page")
    fits(last.offer)
    fits(last.stock)
    mock.hover(panel.details[panel.waypointBanner:IsShown() and 4 or 2])
    assert(hasLine(mock.tooltipLines(), items[11].name), "hover must expose the full long item name")
    mock.hover(nil)
    mock.click(panel.previous)
    choose(panel.stock, "Sold out")
    assert(panel.details[1].row.id == items[3].id and not panel.details[2].row, "sold-out stock filter")
    choose(panel.stock, "In stock")
    assert(panel.details[1].row.id == trackedItem and panel.details[2].row.id == items[4].id, "in-stock filter")
    choose(panel.stock, "Unknown stock")
    assert(not panel.details[1].row, "known stock cannot match unknown stock")
    choose(panel.stock, "All stock")
    mock.typeText(panel.detailSearch, "Arcane")
    assert(panel.details[1].row.id == trackedItem and not panel.details[2].row, "inventory name search")
    mock.click(panel.details[1])
    assert(panel.tab == "items" and panel.selected == trackedItem, "inventory click should open the item")
    mock.click(panel.back)
    assert(panel.tab == "vendors" and panel.selected == farID and panel.detailSearch:GetText() == "Arcane",
        "Back restores inventory selection and search")
    mock.click(panel.source)
    mock.click(panel.advanced.sources[3])
    assert(not panel.index.vendors[farID], "bundled filter included a personal merchant")
    mock.click(panel.clearFilters)
    assert(panel.search:GetText() == "Bronze" and panel.index.vendors[farID], "reset lost the search or merchant")
    choose(panel.zone, "Current zone")
    assert(panel.filters.zone == "@current" and panel.index.vendors[farID], "current-zone filter lost a local merchant")
    if panel.compact and panel.selected then mock.click(panel.back) end
    mock.click(panel.list[1])
    assert(panel.detailSearch:GetText() == "" and panel.detailSearch.placeholder:IsVisible(), "cleared inventory search lost its hint")
    mock.hover(nil)
end

@test("renders the observed sellers and expands the item tooltip")
local function sellers()
    local vic = addon()
    if vic.browserPanel then vic.browserPanel:Hide() end
    farMerchant()
    nearMerchant()
    local panel = browser()
    selectItem(panel)
    assert(panel.detailCount:GetText() == "SELLERS  2", "both visits should be visible")
    frontOf(panel.heading, panel.detailHeader)
    fits(panel.details[1].location)
    separated(panel.details[1].offer, panel.details[1].stock, "seller price overlaps stock")
    assert(not panel.details[1].info and panel.details[1].summary:IsShown() and panel.details[1].vendorLink:IsShown(),
        "seller must expand in place and give a Vendor link")
    mock.click(panel.details[2])
    assert(not panel.details[1].summary:IsShown() and panel.details[2].summary:IsShown(), "only the selected seller should expand")
    mock.hover(panel.details[2])
    assert(hasLine(mock.tooltipLines(), "Observed"), "the full offer details must be available on hover")
    mock.hover(nil)
    local compactLines = mock.showTooltip("item", { id = trackedItem })
    assert(hasLine(compactLines, "Sold by vendor") and not hasLine(compactLines, nearName), "the tooltip should start compact")
    mock.setModifiers({ alt = true })
    local expandedLines = mock.tooltipLines()
    assert(hasLine(expandedLines, nearName) and hasLine(expandedLines, farName), "Alt should show both known vendors")
    mock.setModifiers({})
    assert(not hasLine(mock.tooltipLines(), nearName), "releasing Alt should collapse the tooltip")
    GameTooltip:Hide()
end

@test("orders observed sellers by proximity or name")
local function sorting()
    local vic = addon()
    if vic.browserPanel then vic.browserPanel:Hide() end
    farMerchant()
    nearMerchant()
    local panel = browser()
    selectItem(panel)
    assert(panel.details[1].row.id == nearID and panel.details[2].row.id == farID,
        "closest-first setting should put the nearby merchant first")
    vic.settings.showClosestFirst = false
    vic:RefreshBrowser()
    assert(panel.details[1].row.id == farID and panel.details[2].row.id == nearID,
        "disabling closest-first should order merchants by name")
    vic.settings.showClosestFirst = true
end

@test("renders the expanded native item tooltip")
local function tooltip()
    local vic = addon()
    if vic.browserPanel then vic.browserPanel:Hide() end
    farMerchant()
    nearMerchant()
    mock.setModifiers({ alt = true })
    local lines = mock.showTooltip("item", { id = trackedItem })
    assert(GameTooltip:IsVisible() and hasLine(lines, farName) and hasLine(lines, nearName), "expanded tooltip is incomplete")
    if GetPhysicalScreenSize() == 480 then
        assert(GameTooltip:GetWidth() <= UIParent:GetWidth(), "vendor lines make the tooltip wider than the viewport")
        assert(hasLine(lines, "Elwynn Forest") and hasLine(lines, " / 2"), "narrow tooltip lost the location or batch quote")
    end
end

@test("renders the searchable zone picker")
local function zonePicker()
    farMerchant()
    mock.closeMerchant()
    local panel = browser()
    selectItem(panel)
    mock.click(panel.zone)
    assert(panel.menu.title:GetText() == "FILTER BY ZONE")
    mock.typeText(panel.menu.search, "Elwynn")
    assert(panel.menu.rows[1].entryLabel:GetText() == "Elwynn Forest" and not panel.menu.rows[2]:IsVisible())
    panel.menu:Hide()
    mock.click(panel.zone)
end

@test("renders the advanced browser filters")
local function advancedFilters()
    farMerchant()
    mock.closeMerchant()
    local panel = browser()
    selectItem(panel)
    mock.click(panel.source)
    assert(panel.advanced:IsVisible() and panel.clearFilters:IsVisible())
    mock.click(panel.advanced.access)
    assert(panel.filters.allFactions, "the access checkbox did not show inaccessible vendors")
    mock.click(panel.advanced.sources[2])
    assert(panel.filters.source == "personal", "the personal source choice did not apply")
    mock.click(panel.clearFilters)
    assert(not panel.filters.allFactions and not panel.filters.source and panel.search:GetText() == tostring(trackedItem))
end

@test("renders no results and zone recovery")
local function noResults()
    farMerchant()
    mock.closeMerchant()
    local panel = freshBrowser()
    selectItem(panel)
    mock.moveTo({ mapID = 1453, zone = "Stormwind City", x = 0.64, y = 0.72 })
    choose(panel.zone, "Current zone")
    assert(panel.empty:IsVisible() and panel.allZones:IsVisible() and not panel.detailsInset:IsVisible())
    assert(tonumber(panel.vendorsTab.count:GetText()) > 0, "filtering Items must preserve the Vendors tab count")
    mock.click(panel.allZones)
    assert(#panel.rows == 1 and panel.search:GetText() == tostring(trackedItem) and not panel.filters.zone)
    choose(panel.zone, "Current zone")
end

@test("renders an unnamed item searchable by ID")
local function unnamedItem()
    local vic = addon()
    local id = 900199
    local guid = UnitGUID("player")
    assert(guid and not issecretvalue(guid))
    vic.personalIndex = { [id] = { [farID] = { [guid] = {
        observedAt = vic:ObservationNow(), vendorName = farName,
    } } } }
    local panel = freshBrowser()
    mock.typeText(panel.search, tostring(id))
    mock.click(panel.list[1])
    assert(panel.unnamed:IsVisible() and panel.heading:GetText() == "Item #" .. id)
    assert(panel.details[1].vendorLink:IsVisible(), "an unresolved name must not prevent browsing vendors")
end

@test("renders the waypoint set state")
local function waypointSet()
    farMerchant()
    mock.closeMerchant()
    local panel = freshBrowser()
    selectVendor(panel)
    mock.waitUntil(function() return addon():BrowserItemName(trackedItem) == items[2].name end, "item artwork")
    local map: any = C_Map
    local point: any
    local getPoint, setPoint = map.GetUserWaypoint, map.SetUserWaypoint
    map.GetUserWaypoint = function() return point end
    map.SetUserWaypoint = function(value: any) point = value end
    mock.click(panel.track)
    map.GetUserWaypoint, map.SetUserWaypoint = getPoint, setPoint
    assert(panel.track:GetText() == "Remove Waypoint" and panel.waypointBanner:IsVisible())
    assert(panel.waypointStatus:GetText():find("Waypoint set", 1, true))
end

@test("renders the waypoint unavailable state")
local function waypointUnavailable()
    local vic = addon()
    local now = vic:ObservationNow()
    local id = 900003
    vic.Vendors[id] = { "Fixture Expired Merchant", "Elwynn Forest", "?", 22, 35,
        mapID = 1429, nameExpires = now + 100, locationExpires = now - 1 }
    for _, item in ipairs(items) do
        mock.defineItem(item.id, { name = item.name, icon = 134712, maxStack = 200, quality = 1 })
        vic.Items[item.id] = { v = { id }, offers = { [id] = { expires = now + 100, reporters = 3 } } }
    end
    local panel = freshBrowser()
    mock.click(panel.vendorsTab)
    mock.typeText(panel.search, tostring(id))
    mock.click(panel.list[1])
    mock.waitUntil(function() return vic:BrowserItemName(trackedItem) == items[2].name end, "item artwork")
    assert(not panel.track:IsEnabled() and panel.waypointBanner:IsVisible())
    assert(panel.waypointStatus:GetText():find("Location expired", 1, true))
    vic.Vendors[id] = nil
    for _, item in ipairs(items) do vic.Items[item.id] = nil end
end

@test("renders the data overview without personal observations")
local function dataEmpty()
    local vic = addon()
    local observations, index = vic.observations, vic.personalIndex
    vic.observations, vic.personalIndex = { schema = 1, characters = {} }, {}
    mock.click(freshBrowser().data)
    local data = vic.exportPanel
    assert(data.views.overview:IsVisible() and data.metrics[3].value:GetText() == "0")
    assert(not data.contribute:IsEnabled() and data.contribute:GetText() == "Nothing to export")
    vic.observations, vic.personalIndex = observations, index
end

@test("renders Vendor Item Check in native AddOns settings")
local function options()
    local vic = addon()
    mock.slash("/vic settings")
    assert(vic.optionsPanel:IsVisible() and vic.optionsPreview:IsVisible())
    assert(vic.optionsPreview.lines[1].left:GetText():find("Sold by vendors", 1, true))
end

@test("renders the contextual settings hint")
local function settingsHelp()
    mock.slash("/vic settings")
    local help: any = _G["VICMaximumVendorsHelp"]
    mock.waitUntil(function() return help:IsVisible() and help:GetLeft() ~= nil end, "visible settings help")
    mock.hover(help)
    local hint = addon().settingsHint
    assert(hint:IsVisible() and hint.title:GetText() == "Maximum vendors")
    assert(hint.body:GetText():find("Range", 1, true))
end

@test("renders the collapsed native item tooltip")
local function tooltipCollapsed()
    local settings: any = _G["SettingsPanel"]
    if settings then settings:Hide() end
    if addon().browserPanel then addon().browserPanel:Hide() end
    farMerchant()
    mock.closeMerchant()
    mock.setModifiers({})
    local lines = mock.showTooltip("item", { id = trackedItem })
    assert(hasLine(lines, "Sold by vendor") and hasLine(lines, "Hold ALT"))
end

@test("renders the minimal expanded native item tooltip")
local function tooltipMinimal()
    local settings: any = _G["SettingsPanel"]
    if settings then settings:Hide() end
    if addon().browserPanel then addon().browserPanel:Hide() end
    farMerchant()
    mock.closeMerchant()
    local vic = addon()
    vic.settings.showCoordinates, vic.settings.showPrice = false, false
    mock.setModifiers({ alt = true })
    local lines = mock.showTooltip("item", { id = trackedItem })
    assert(hasLine(lines, "Sold by vendors") and hasLine(lines, farName) and hasLine(lines, "Elwynn Forest"))
    assert(not hasLine(lines, "approx.") and not hasLine(lines, " / 2"))
end
